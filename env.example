#--------------------------------------------------------------------
# SISTEM MONITORING AIR KOLAM
# Environment Configuration
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE MYSQL
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = monitoring_kolam
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# MQTT BROKER CONFIGURATION
#--------------------------------------------------------------------

# Alamat MQTT Broker (localhost atau IP address broker)
MQTT_BROKER = localhost

# Port MQTT (default: 1883 untuk non-SSL, 8883 untuk SSL)
MQTT_PORT = 1883

# MQTT Username (kosongkan jika tidak pakai autentikasi)
MQTT_USERNAME = 

# MQTT Password (kosongkan jika tidak pakai autentikasi)
MQTT_PASSWORD = 

# Client ID untuk web server
MQTT_CLIENT_ID = MonitoringKolam_Web

#--------------------------------------------------------------------
# MQTT TOPICS
#--------------------------------------------------------------------

# Topic untuk data sensor (subscribe)
MQTT_TOPIC_SENSORS = kolam/sensors/data

# Topic untuk command control (publish)
MQTT_TOPIC_CONTROL = kolam/control

# Topic untuk status devices (subscribe)
MQTT_TOPIC_STATUS = kolam/status

#--------------------------------------------------------------------
# SENSOR THRESHOLDS (Default Values)
#--------------------------------------------------------------------

# Suhu air (°C)
THRESHOLD_TEMP_MIN = 26
THRESHOLD_TEMP_MAX = 30

# pH air
THRESHOLD_PH_MIN = 6.5
THRESHOLD_PH_MAX = 7.5

# Dissolved Oxygen (mg/L)
THRESHOLD_DO_MIN = 5.0

# Kekeruhan/Turbidity (NTU)
THRESHOLD_TURBIDITY_MAX = 50

# TDS (ppm)
THRESHOLD_TDS_MAX = 1000

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4
